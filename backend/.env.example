# Copia este archivo como .env (no se sube a git) y deja solo lo que cambie en tu computadora.
# Sin .env la API usa: puerto 8080, base tdimp en localhost:5432, usuario tdimp / contraseña tdimp.

# Puerto de la API.
PORT=8080

