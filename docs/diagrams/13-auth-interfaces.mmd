---
config:
  layout: elk
---
%% Class diagram of authentication: interfaces, implementations and polymorphism.
%% Classes without «interface» are package-private (not public).
%% transversales: TokenIssuer and RateLimiter live in service/, PasswordEncoder is the bean of config/SecurityConfig.
classDiagram
  direction TB

  namespace controller {
    class AuthController {
      +register(RegisterRequest) TokenResponse
      +login(LoginRequest) TokenResponse
      +refresh(RefreshRequest) TokenResponse
      +logout(RefreshRequest) void
      +reauthenticate(AccessClaims, ReauthenticateRequest) TokenResponse
    }
    class RefreshChannel {
      <<interface>>
      +supports(ClientType) boolean
      +read(HttpServletRequest, RefreshRequest) Optional~String~
      +deliver(TokenResponse, HttpServletResponse) TokenResponse
      +clear(HttpServletResponse) void
    }
    class CookieRefreshChannel
    class BodyRefreshChannel
  }

  namespace service {
    class AuthService {
      <<interface>>
      +register(RegisterRequest, String userAgent) AuthResult
      +login(LoginRequest, String userAgent) AuthResult
      +refresh(String, String userAgent) AuthResult
      +logout(String) void
      +reauthenticate(AccessClaims, String) TokenResponse
    }
    class AuthServiceImpl
  }

  namespace repository {
    class PlayerRepository {
      <<interface>>
      +findByEmail(String) Optional~Player~
      +emailExists(String) boolean
      +insert(String, String, String, OffsetDateTime) Player
    }
    class AuthSessionRepository {
      <<interface>>
      +findByTokenHashForUpdate(String) Optional~AuthSession~
      +revokeFamily(UUID, RevocationReason, OffsetDateTime) int
    }
  }

  namespace transversales {
    class TokenIssuer {
      <<interface>>
      +issueAccessToken(UUID, UUID, ClientType, Instant) String
      +verify(String) AccessClaims
    }
    class HmacTokenIssuer
    class RateLimiter {
      <<interface>>
      +acquire(RateLimitRule, String key) void
      +reset(RateLimitRule, String key) void
    }
    class InMemoryRateLimiter
    class NoOpRateLimiter
    class PasswordEncoder {
      <<interface>>
      +encode(CharSequence) String
      +matches(CharSequence, String) boolean
    }
    class DelegatingPasswordEncoder
  }

  AuthController --> AuthService : usa
  AuthController --> "2" RefreshChannel : usa
  CookieRefreshChannel ..|> RefreshChannel : WEB
  BodyRefreshChannel ..|> RefreshChannel : UNITY_PC, MOBILE
  AuthServiceImpl ..|> AuthService
  AuthServiceImpl --> PlayerRepository
  AuthServiceImpl --> AuthSessionRepository
  AuthServiceImpl --> TokenIssuer
  AuthServiceImpl --> RateLimiter
  AuthServiceImpl --> PasswordEncoder
  HmacTokenIssuer ..|> TokenIssuer : HS256
  InMemoryRateLimiter ..|> RateLimiter : local, prod
  NoOpRateLimiter ..|> RateLimiter : test
  DelegatingPasswordEncoder ..|> PasswordEncoder : BCrypt
