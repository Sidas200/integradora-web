m","value":"\"Windows\""},{"name":"Referer","value":"http://localhost:4173/news/ya-puedes-jugar-la-demo-del-capitulo-1"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.8078.4 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\", \"HeadlessChrome\";v=\"156\""},{"name":"Accept-Language","value":"es-MX"},{"name":"sec-ch-ua-mobile","value":"?0"}],"queryString":[],"headersSize":433,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"x-request-id","value":"1d6bdfde"},{"name":"cache-control","value":"max-age=300, public"},{"name":"connection","value":"close"},{"name":"server-timing","value":"app;desc=\"Spring Boot\";dur=4.8, db;desc=\"PostgreSQL\";dur=1.2"},{"name":"content-length","value":"1248"},{"name":"date","value":"Sun, 22 Nov 2026 21:53:10 GMT"},{"name":"content-type","value":"application/json"},{"name":"Vary","value":"Origin"}],"content":{"size":1248,"mimeType":"application/json","compression":1528,"text":"{\"slug\":\"ya-puedes-jugar-la-demo-del-capitulo-1\",\"title\":\"Ya puedes jugar la demo del capítulo 1\",\"summary\":\"Dos zonas, la forja de Kaede y el duelo contra Varn. Descarga gratis la demo para Windows y juega de 20 a 30 minutos.\",\"coverKey\":\"news_demo\",\"publishedAt\":\"2026-11-21T00:00:00Z\",\"contentMd\":\"\\nLa espera terminó: **la demo del capítulo 1 ya está disponible** y es gratis.\\n\\n## Qué incluye\\n\\n- La **Isla de las Flores** y el camino a tierra firme.\\n- El campamento y la **forja de Kaede**, con sus recetas y mejoras.\\n- La **prueba del Santuario**.\\n- El duelo contra **Varn, el Guardián del Umbral**.\\n\\nSe juega en **20 a 30 minutos**.\\n\\n## Requisitos mínimos\\n\\n- **Sistema:** Windows 10 u 11 (64 bits)\\n- **Gráficos:** compatible con DirectX 11 o 12\\n- **Espacio:** 600 MB libres\\n- **Controles:** teclado y mouse\\n\\n## Cómo instalarla\\n\\n1. Ve a la sección *Descarga la demo* de la página principal y descarga el archivo ZIP.\\n2. Descomprímelo en cualquier carpeta.\\n3. Abre `TheDayIMadeThatPromise.exe`.\\n\\nCrea tu cuenta para guardar tu partida en la nube y ver tu progreso desde la web y la app.\\n\\nGracias a todas las personas que probaron las versiones tempranas. Esta demo también es suya.\\n\\n— *Hex Studio*\\n\"}"},"headersSize":280,"bodySize":-280,"redirectURL":"","_transferSize":0},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":13.253,"receive":0.625},"_frameref":"frame@c81a02acc1cd850f5313e8d7f243abd4","_monotonicTime":16429.732,"_resourceType":"fetch","_securityDetails":{}},{"startedDateTime":"2026-11-22T21:53:10.723Z","time":11.551,"request":{"method":"GET","url":"http://localhost:4173/api/v1/news/ya-puedes-jugar-la-demo-del-capitulo-1","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"es-MX"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:4173"},{"name":"Referer","value":"http://localhost:4173/news/ya-puedes-jugar-la-demo-del-capitulo-1"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.8078.4 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\", \"HeadlessChrome\";v=\"156\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""}],"queryString":[],"headersSize":608,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Vary","value":"Origin"},{"name":"cache-control","value":"max-age=300, public"},{"name":"connection","value":"close"},{"name":"content-length"